#!/usr/bin/env python3
"""Refresh BBC, YouTube and RugbyPass catalogues and match known rugby fixtures.

Without --apply: query providers and preview counts, no Atlas writes.
With --apply: validate all source responses before upserting and matching.
This command NEVER downloads or changes any media files.
"""
import argparse
import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent
from orchestration.source_registry import RUGBY_SOURCES
from orchestration.locks import LockBusy, site_lock

SOURCES = RUGBY_SOURCES


def load_file(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(ROOT / path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def scan_rugbypass(*, script="~/tools/video/rugbypass", pages=5,
                   execute=subprocess.run):
    cmd = [str(pathlib.Path(script).expanduser()),
           "--list-games", "--jsonl", "--pages", str(pages)]
    result = execute(cmd, capture_output=True, text=True, check=False)
    if result.returncode:
        # The source tool can log authenticated URLs; avoid propagating them.
        raise RuntimeError(f"RugbyPass catalogue failed with exit {result.returncode}; "
                           "check the local RugbyPass auth status")
    records = []
    for line in result.stdout.splitlines():
        if line.strip():
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError as exc:
                raise ValueError("RugbyPass catalogue produced non-JSON output") from exc
    return records


def discover_sources(sources, *, youtube_limit=100, bbc_pages=10,
                     rugbypass_pages=5, rugby24_pages=2,
                     rugbypass="~/tools/video/rugbypass",
                     yt_dlp="yt-dlp", bbc_discover=None, yt_discover=None,
                     rp_discover=scan_rugbypass, rugby24_discover=None):
    if not 1 <= youtube_limit <= 5000 or not 1 <= bbc_pages <= 20 or not 1 <= rugbypass_pages <= 50 or not 1 <= rugby24_pages <= 25:
        raise ValueError("Provider paging limits are out of range")
    bbc = load_file("pvr_refresh_bbc", "indexers/bbc")
    yt = load_file("pvr_refresh_youtube", "indexers/youtube")
    output = {}
    for source in sources:
        if source == "bbc":
            output[source] = (bbc_discover or bbc.discover)(
                bbc.DEFAULT_BRAND, max_pages=bbc_pages)
        elif source == "youtube":
            output[source] = (yt_discover or yt.discover)(
                yt.DEFAULT_URL, limit=youtube_limit, binary=yt_dlp)
        elif source == "rugbypass":
            output[source] = rp_discover(script=rugbypass, pages=rugbypass_pages)
        elif source == "rugby24":
            adapter = load_file("pvr_refresh_rugby24", "indexers/rugby24")
            output[source] = (rugby24_discover or adapter.discover)(pages=rugby24_pages)
        else:
            raise ValueError(f"Unknown source: {source}")
    return output


def _run_unlocked(database, *, apply=False, sources=SOURCES, youtube_limit=100,
        bbc_pages=10, rugbypass_pages=5, rugby24_pages=2,
        rugbypass="~/tools/video/rugbypass", yt_dlp="yt-dlp",
        discover=discover_sources, output=sys.stdout):
    sources = tuple(dict.fromkeys(sources))
    if not sources or any(source not in SOURCES for source in sources):
        raise ValueError("Specify at least one supported rugby source")
    results = discover(sources, youtube_limit=youtube_limit, bbc_pages=bbc_pages,
                       rugbypass_pages=rugbypass_pages,
                       rugby24_pages=rugby24_pages,
                       rugbypass=rugbypass, yt_dlp=yt_dlp)
    indexer = load_file("pvr_refresh_index_releases", "index_releases")
    matcher = load_file("pvr_refresh_match_releases", "match_releases")
    validated = {}
    counts = {}
    for source in sources:
        records = results[source]
        if not isinstance(records, list):
            raise ValueError(f"{source} indexer did not return a list")
        serialized = io.StringIO("".join(json.dumps(x) + "\n" for x in records))
        parsed = indexer.read_records(serialized)
        if any(row.get("source") != source for row in parsed.values()):
            raise ValueError(f"Catalogue contains a mismatched source: {source}")
        validated[source] = parsed
        counts[source] = len(parsed)
    if apply:
        for source in sources:
            indexer.upsert_releases(database, validated[source])
        matched = (matcher.run(database, apply=True,
                               source=sources[0] if len(sources) == 1 else None,
                               stream=io.StringIO(), summary_stream=io.StringIO())
                   if any(s in ("bbc", "youtube", "rugbypass") for s in sources)
                   else None)
        if "rugbypass" in sources:
            national = load_file("pvr_refresh_match_rugbypass", "match_rugbypass")
            national_report = national.run(
                database, apply=True, stream=io.StringIO(),
                summary_stream=io.StringIO())
        else:
            national_report = None
        if "rugby24" in sources:
            prem = load_file("pvr_refresh_match_prem", "match_prem")
            prem_report = prem.run(database, apply=True, stream=io.StringIO(),
                                   summary_stream=io.StringIO())
        else:
            prem_report = None
    else:
        matched = None
        national_report = None
        prem_report = None
    outcome = {"mode": "apply" if apply else "preview",
               "sources": list(sources), "releases": counts,
               "total_releases": sum(counts.values()),
               "matching": matched, "international_matching": national_report,
               "prem_matching": prem_report,
               "note": "Preview does not link newly discovered releases" if not apply else None}
    print(json.dumps(outcome, sort_keys=True), file=output)
    return outcome


def run(database, *, apply=False, sources=SOURCES, youtube_limit=100,
        bbc_pages=10, rugbypass_pages=5, rugby24_pages=2,
        rugbypass="~/tools/video/rugbypass", yt_dlp="yt-dlp",
        discover=discover_sources, output=sys.stdout, lock_root=None):
    """Hold each provider's indexer lock through discovery and Atlas matching.

    CLI always supplies lock_root. Library tests can leave it None to inject
    fake provider results without touching the host filesystem.
    """
    sources = tuple(dict.fromkeys(sources))
    with contextlib.ExitStack() as stack:
        if lock_root is not None:
            # Preview also fetches providers; protect every source request.
            # Stable ordering prevents deadlocks for multi-source manual runs.
            for source in sorted(sources):
                stack.enter_context(site_lock(lock_root, "indexer", source))
        return _run_unlocked(
            database, apply=apply, sources=sources,
            youtube_limit=youtube_limit, bbc_pages=bbc_pages,
            rugbypass_pages=rugbypass_pages, rugby24_pages=rugby24_pages,
            rugbypass=rugbypass,
            yt_dlp=yt_dlp, discover=discover, output=output)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", action="append", choices=SOURCES,
                        help="Provider to refresh (repeatable; default all three)")
    parser.add_argument("--youtube-limit", type=int, default=100)
    parser.add_argument("--bbc-pages", type=int, default=10)
    parser.add_argument("--rugbypass-pages", type=int, default=5)
    parser.add_argument("--rugby24-pages", type=int, default=2)
    parser.add_argument("--rugbypass", default="~/tools/video/rugbypass")
    parser.add_argument("--yt-dlp", default="yt-dlp")
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--database", default=os.environ.get("MONGODB_DATABASE", "pvr"))
    parser.add_argument("--lock-root", default="/data/incoming",
                        help="Shared local directory for per-site indexer locks")
    args = parser.parse_args(argv)
    uri = os.environ.get("MONGODB_URI")
    if not uri:
        try:
            uri = (pathlib.Path.home() / ".mongodb" / "pvr").read_text().strip()
        except OSError as exc:
            parser.error(f"Cannot read MongoDB URI: {exc}")
    if not uri:
        parser.error("Empty MongoDB URI")
    from pymongo import MongoClient
    try:
        with MongoClient(uri, serverSelectionTimeoutMS=15000) as client:
            client.admin.command("ping")
            run(client[args.database], sources=args.source or SOURCES,
                youtube_limit=args.youtube_limit, bbc_pages=args.bbc_pages,
                rugbypass_pages=args.rugbypass_pages,
                rugby24_pages=args.rugby24_pages, rugbypass=args.rugbypass,
                yt_dlp=args.yt_dlp, apply=args.apply, lock_root=args.lock_root)
    except LockBusy as exc:
        print(f"PVR source refresh busy: {exc}", file=sys.stderr)
        return 75  # Temporary lock contention, not a provider failure.
    except Exception as exc:
        print(f"PVR source refresh: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
