#!/usr/bin/env python3
"""Preview or import official Gallagher PREM player selections into MongoDB."""
import argparse
import datetime as dt
import json
import os
from pathlib import Path
import sys

from schedulers.rugby import prem_lineups as lineups


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true",
                        help="Write MongoDB; without this, print eligible fixture IDs")
    parser.add_argument("--force", action="store_true",
                        help="Recheck completed or not-yet-due fixtures")
    parser.add_argument("--season", type=int, help="Calendar season start, e.g. 2026")
    parser.add_argument("--fixture", type=int, help="Official PREM match ID")
    parser.add_argument("--limit", type=int, default=50,
                        help="Maximum matches per run (0 = all)")
    parser.add_argument("--database", default=os.getenv("MONGODB_DATABASE", "pvr"))
    args = parser.parse_args(argv)
    if args.limit < 0 or args.fixture is not None and args.fixture <= 0:
        parser.error("Invalid limit or fixture")
    uri = os.getenv("MONGODB_URI")
    if not uri:
        uri = (Path.home() / ".mongodb" / "pvr").read_text(encoding="utf-8").strip()
    if not uri:
        parser.error("MongoDB connection URI is empty")
    from pymongo import MongoClient
    now = dt.datetime.now(dt.timezone.utc)
    errors = 0
    with MongoClient(uri, serverSelectionTimeoutMS=15000) as client:
        database = client[args.database]
        todo = lineups.candidates(database, season=args.season, fixture=args.fixture,
                                  force=args.force, limit=args.limit, now=now)
        for ep in todo:
            fixture = lineups.fixture_id(ep)
            if not args.apply:
                print(json.dumps({"fixture_id": fixture, "episode_id": ep["_id"],
                                  "preview": True}))
                continue
            try:
                record = lineups.normalize(lineups.fetch(fixture), ep, now=now)
                changed = lineups.upsert(database, record)
                print(json.dumps({
                    "fixture_id": fixture, "episode_id": ep["_id"],
                    "status": record["status"],
                    "home": len(record["home"]), "away": len(record["away"]),
                    "updated": changed,
                }))
            except (OSError, RuntimeError, ValueError, KeyError, TypeError) as exc:
                errors += 1
                print(f"PREM lineup {fixture}: {exc}", file=sys.stderr)
    print(json.dumps({"candidates": len(todo), "preview": not args.apply,
                      "errors": errors}), file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
