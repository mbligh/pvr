#!/usr/bin/env python3
"""Match RugbyPass full replays to numbered international/Nations/WXV/Six Nations fixtures.

Read-only by default. --apply links only one unambiguous team/competition/date
match. Existing release associations are never changed, even if incorrect.
"""
import argparse
import collections
import datetime as dt
import json
import os
import pathlib
import sys

from matchers.rugbypass import METHOD, SERIES, match_release


def run(database, *, apply=False, series_ids=SERIES, verbose=False,
        max_delay_days=3, stream=sys.stdout, summary_stream=sys.stderr):
    series_ids = tuple(dict.fromkeys(series_ids))
    if not series_ids or any(s not in SERIES for s in series_ids):
        raise ValueError("Invalid RugbyPass series selection")
    episodes = list(database.episodes.find(
        {"series_id": {"$in": list(series_ids)}},
        {"_id": 1, "series_id": 1, "season": 1, "episode": 1, "nfo": 1,
         "nfo_path": 1, "home": 1, "away": 1, "scheduled": 1}
    ))
    if not episodes:
        raise ValueError("No target rugby fixtures in Atlas; import rugby fixtures first")
    counts = collections.Counter()
    now = dt.datetime.now(dt.timezone.utc)
    for release in database.releases.find({"source": "rugbypass"}):
        matched = match_release(release, episodes, max_delay_days=max_delay_days)
        status = matched["status"]
        existing = release.get("episode_id")
        if existing:
            if existing == matched.get("episode_id"):
                status = "already_linked"
            else:
                status = "existing_link"
                matched["existing_episode_id"] = existing
        elif status == "candidate" and apply:
            metadata = {
                "method": METHOD,
                "competition": matched["series_id"],
                "teams": matched["teams"],
                "published_at": matched["published_at"],
                "scheduled_at": matched["scheduled_at"],
                "delay_hours": matched["delay_hours"],
            }
            result = database.releases.update_one(
                {"_id": release["_id"], "episode_id": None},
                {"$set": {"episode_id": matched["episode_id"],
                          "match_method": METHOD,
                          "match_details": metadata,
                          "matched_at": now}},
            )
            status = "linked" if result.modified_count == 1 else "write_conflict"
        matched.update(status=status, uri=release["_id"],
                       title=release.get("title"))
        counts[status] += 1
        if status in ("candidate", "linked", "already_linked", "ambiguous",
                      "unnumbered_fixture", "existing_link", "write_conflict") or verbose:
            print(json.dumps(matched, ensure_ascii=False, default=str), file=stream)
    report = {"mode": "apply" if apply else "preview", "source": "rugbypass",
              "series": list(series_ids), "fixtures": len(episodes),
              "processed": sum(counts.values()), **dict(sorted(counts.items()))}
    print(json.dumps(report, sort_keys=True), file=summary_stream)
    return report


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--series", action="append", choices=SERIES,
                        help="Target series; repeat for multiple (default all supported)")
    parser.add_argument("--max-delay-days", type=int, default=3,
                        help="Max replay publishing delay after fixture, 0..7 days")
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--apply", action="store_true",
                        help="Link verified releases in Atlas; default preview")
    parser.add_argument("--database", default=os.getenv("MONGODB_DATABASE", "pvr"))
    args = parser.parse_args(argv)
    if not 0 <= args.max_delay_days <= 7:
        parser.error("--max-delay-days must be 0..7")
    uri = os.getenv("MONGODB_URI")
    if not uri:
        try:
            uri = (pathlib.Path.home() / ".mongodb" / "pvr").read_text(encoding="utf-8").strip()
        except OSError as exc:
            parser.error(f"Cannot read MongoDB URI: {exc}")
    if not uri:
        parser.error("MongoDB URI is empty")
    from pymongo import MongoClient
    try:
        with MongoClient(uri, serverSelectionTimeoutMS=15000) as client:
            client.admin.command("ping")
            run(client[args.database], apply=args.apply,
                series_ids=args.series or SERIES,
                verbose=args.verbose, max_delay_days=args.max_delay_days)
    except Exception as exc:
        print(f"RugbyPass fixture matcher: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
