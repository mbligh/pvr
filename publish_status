#!/usr/bin/env python3
"""Publish public-safe PVR indexer health to the external dashboard.

Default: print a read-only snapshot. --apply: sign and publish changes,
with an hourly heartbeat; never modify Atlas or download media.
"""
import argparse
import datetime as dt
import fcntl
import hashlib
import hmac
import json
import os
from pathlib import Path
import sys
import tempfile
import time
import urllib.error
import urllib.request

from orchestration.polling import database_connection

UTC = dt.timezone.utc
ENDPOINT = "https://mbligh-actions-status.mbligh.workers.dev/external-status/pvr"
INDEXERS = (
    ("bbc", "BBC iPlayer"),
    ("youtube", "YouTube"),
    ("rugbypass", "RugbyPass"),
    ("reddit-teletz", "Reddit / teletz"),
    ("rugby24:prem", "Rugby24 — Premiership"),
    ("rugby24:championship", "Rugby24 — Champions Cup"),
    ("rugby24:sixnations", "Rugby24 — Six Nations"),
)
HEARTBEAT_SECONDS = 3600


def timestamp(value):
    if value is None:
        return None
    if not isinstance(value, dt.datetime):
        raise ValueError("Invalid Atlas timestamp")
    if value.tzinfo is None:
        value = value.replace(tzinfo=UTC)
    return value.astimezone(UTC).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def snapshot(db):
    docs = {row["_id"]: row for row in db.indexer_poll_state.find(
        {"_id": {"$in": [key for key, _ in INDEXERS]}},
        {"last_attempt": 1, "last_success": 1, "failures": 1,
         "retry_not_before": 1, "failure_reason": 1})}
    items = []
    for key, name in INDEXERS:
        row = docs.get(key, {})
        failures = row.get("failures", 0)
        if type(failures) is not int or failures < 0:
            raise ValueError("Invalid Atlas failure count")
        last_success = timestamp(row.get("last_success"))
        status = "failure" if failures else "success" if last_success else "unknown"
        # Never send raw exception text, paths, URLs, or credentials.
        reason = None
        if failures:
            reason = ("cloudflare_challenge" if row.get("failure_reason") ==
                      "cloudflare_challenge" else "discovery_failed")
        items.append(dict(id=key, name=name, status=status, failures=failures,
                          last_attempt=timestamp(row.get("last_attempt")),
                          last_success=last_success,
                          retry_not_before=timestamp(row.get("retry_not_before")),
                          reason=reason))
    return {"version": 1, "group": "pvr", "title": "PVR — Indexers", "items": items}


def encode(data):
    return json.dumps(data, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False).encode("utf-8")


def due(data, previous, now):
    digest = hashlib.sha256(encode(data)).hexdigest()
    sent = previous.get("sent_at")
    return digest, (previous.get("digest") != digest or
                    not isinstance(sent, (int, float)) or
                    now < sent or now - sent >= HEARTBEAT_SECONDS)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def send(data, secret):
    body = encode(data)
    signature = hmac.new(secret.encode("utf-8"), body, hashlib.sha256).hexdigest()
    req = urllib.request.Request(ENDPOINT, data=body, method="POST",
                                 headers={"Content-Type": "application/json",
                                          "X-Status-Signature": "sha256=" + signature})
    with urllib.request.build_opener(NoRedirect()).open(req, timeout=20) as response:
        reply = json.loads(response.read(8192))
        if response.status not in (200, 202) or reply.get("ok") is not True:
            raise RuntimeError("Dashboard rejected snapshot")
        if reply.get("ignored"):
            raise RuntimeError("Dashboard ignored older snapshot; check clocks")


def read_state(path):
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
        return state if isinstance(state, dict) else {}
    except (FileNotFoundError, ValueError):
        return {}


def save_state(path, state):
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                     delete=False) as tmp:
        try:
            json.dump(state, tmp)
            tmp.flush()
            os.fsync(tmp.fileno())
            os.replace(tmp.name, path)
        finally:
            Path(tmp.name).unlink(missing_ok=True)


def publish(db, state_path, secret, *, clock=time.time, transmit=send):
    state_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(str(state_path) + ".lock", "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return "busy"
        data = snapshot(db)
        now = clock()
        digest, changed = due(data, read_state(state_path), now)
        if not changed:
            return "unchanged"
        data["published_at"] = timestamp(dt.datetime.fromtimestamp(now, UTC))
        transmit(data, secret)
        # A failed request must never suppress the next retry.
        save_state(state_path, {"digest": digest, "sent_at": now})
        return "published"


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--database", default=os.getenv("MONGODB_DATABASE", "pvr"))
    parser.add_argument("--secret-file", type=Path,
                        default=Path.home() / ".config/pvr/dashboard-secret")
    parser.add_argument("--state-file", type=Path,
                        default=Path.home() / ".cache/pvr/dashboard-status.json")
    args = parser.parse_args(argv)
    try:
        secret = None
        if args.apply:
            secret = args.secret_file.expanduser().read_text(encoding="utf-8").strip()
            if not secret:
                raise ValueError("Empty dashboard secret")
        with database_connection(args.database) as client:
            db = client[args.database]
            if args.apply:
                result = publish(db, args.state_file.expanduser(), secret)
                print(json.dumps({"type": "dashboard_status", "result": result}))
            else:
                data = snapshot(db)
                data["published_at"] = timestamp(dt.datetime.now(UTC))
                print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    except urllib.error.HTTPError as exc:
        print(f"Dashboard publisher: HTTP {exc.code}", file=sys.stderr)
    except Exception as exc:
        # Do not print arbitrary exceptions: credentials can be present in
        # connection diagnostics. The cron log receives a safe error type.
        print(f"Dashboard publisher: {type(exc).__name__}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
