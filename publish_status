#!/usr/bin/env python3
"""Publish public-safe PVR indexer health to the external dashboard.

Default: print a read-only snapshot. --apply: sign and publish changes,
with an hourly heartbeat; never modify Atlas or download media.
"""
import argparse
import datetime as dt
import fcntl
import hashlib
import hmac
import json
import os
import re
import socket
from pathlib import Path
import sys
import tempfile
import time
import urllib.error
import urllib.request

from orchestration.polling import database_connection

UTC = dt.timezone.utc
ENDPOINT = "https://mbligh-actions-status.mbligh.workers.dev/external-status/pvr"
INDEXERS = (
    ("bbc", "BBC iPlayer"),
    ("youtube", "YouTube"),
    ("rugbypass", "RugbyPass"),
    ("reddit-teletz", "Reddit / teletz"),
    ("rugby24:prem", "Rugby24 — Premiership"),
    ("rugby24:championship", "Rugby24 — Champions Cup"),
    ("rugby24:sixnations", "Rugby24 — Six Nations"),
)
DOWNLOADERS = (
    ("bbc", "BBC iPlayer"),
    ("youtube", "YouTube"),
    ("rugbypass", "RugbyPass"),
    ("rugby24", "Rugby24"),
    ("transfernow", "TransferNow"),
)
HEARTBEAT_SECONDS = 3600


def timestamp(value):
    if value is None:
        return None
    if not isinstance(value, dt.datetime):
        raise ValueError("Invalid Atlas timestamp")
    if value.tzinfo is None:
        value = value.replace(tzinfo=UTC)
    return value.astimezone(UTC).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def local_download_activity(job):
    """Read the existing provider lock without creating or changing files."""
    if job.get("host") != socket.gethostname():
        return "unknown"
    destination = job.get("destination")
    if not isinstance(destination, str) or not Path(destination).is_absolute():
        return "unknown"
    lock = Path(destination).parent / (".pvr-download-" + job["adapter"] + ".lock")
    try:
        fd = os.open(lock, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return "interrupted"
    except OSError:
        return "unknown"
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return "running"
        except OSError:
            return "unknown"
        return "interrupted"
    finally:
        os.close(fd)


def safe_failure(error):
    # Classify locally; raw diagnostics can include URLs, paths and tokens.
    text = str(error or "").lower()
    for code in ("403", "404", "429"):
        if re.search(r"(?:http(?: error| status)?[: ]+|status code[: ]+)" + code + r"\b", text):
            return "http_" + code
    if "timeout" in text or "timed out" in text:
        return "timeout"
    if any(word in text for word in ("ffprobe", "verification", "no video")):
        return "verification_failed"
    return "download_failed"


def downloader_snapshot(db, *, activity=None):
    """At most three bounded job lookups per adapter, with cached event titles."""
    activity = activity or local_download_activity
    titles = {}
    def title(job):
        episode_id = job.get("episode_id")
        if not isinstance(episode_id, str):
            return "Unknown event"
        if episode_id not in titles:
            ep = db.episodes.find_one({"_id": episode_id},
                                      {"title": 1, "home": 1, "away": 1}) or {}
            value = ep.get("title")
            if not value and ep.get("home") and ep.get("away"):
                value = f'{ep["home"]} vs {ep["away"]}'
            # Only canonical episode titles, never release URLs or destinations.
            value = " ".join(value.split()) if isinstance(value, str) else ""
            if re.search(r"https?://|[\\\\]|(?:^| )/(?:home|data|tmp|srv)/", value, re.I):
                value = ""
            titles[episode_id] = value[:200] or "Unknown event"
        return titles[episode_id]

    def event(job, status, field, reason=None):
        if not job or not isinstance(job.get(field), dt.datetime):
            return None
        return dict(status=status, title=title(job),
                    **{field: timestamp(job[field])}, reason=reason)

    result = []
    for adapter, name in DOWNLOADERS:
        query = {"type": "download", "adapter": adapter}
        fields = {"episode_id": 1, "adapter": 1, "host": 1, "destination": 1,
                  "status": 1, "started_at": 1, "finished_at": 1, "error": 1}
        latest = db.jobs.find_one(query, fields,
                                  sort=[("started_at", -1), ("_id", -1)])
        success = db.jobs.find_one(dict(query, status="succeeded"), fields,
                                   sort=[("finished_at", -1), ("_id", -1)])
        failure = db.jobs.find_one(dict(query, status="failed"), fields,
                                   sort=[("finished_at", -1), ("_id", -1)])
        current = None
        if latest and latest.get("status") == "running":
            state = activity(latest)
            reason = {"interrupted": "interrupted", "unknown": "activity_unknown"}.get(state)
            current = event(latest, state, "started_at", reason)
        result.append(dict(id=adapter, name=name, current=current,
                           last_success=event(success, "succeeded", "finished_at"),
                           last_failure=event(failure, "failed", "finished_at",
                                              safe_failure(failure.get("error")) if failure else None)))
    return result


def snapshot(db):
    docs = {row["_id"]: row for row in db.indexer_poll_state.find(
        {"_id": {"$in": [key for key, _ in INDEXERS]}},
        {"last_attempt": 1, "last_success": 1, "failures": 1,
         "retry_not_before": 1, "failure_reason": 1})}
    items = []
    for key, name in INDEXERS:
        row = docs.get(key, {})
        failures = row.get("failures", 0)
        if type(failures) is not int or failures < 0:
            raise ValueError("Invalid Atlas failure count")
        last_success = timestamp(row.get("last_success"))
        status = "failure" if failures else "success" if last_success else "unknown"
        # Never send raw exception text, paths, URLs, or credentials.
        reason = None
        if failures:
            reason = ("cloudflare_challenge" if row.get("failure_reason") ==
                      "cloudflare_challenge" else "discovery_failed")
        items.append(dict(id=key, name=name, status=status, failures=failures,
                          last_attempt=timestamp(row.get("last_attempt")),
                          last_success=last_success,
                          retry_not_before=timestamp(row.get("retry_not_before")),
                          reason=reason))
    return {"version": 1, "group": "pvr", "title": "PVR — Indexers", "items": items,
            "downloaders": downloader_snapshot(db)}


def encode(data):
    return json.dumps(data, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False).encode("utf-8")


def due(data, previous, now):
    digest = hashlib.sha256(encode(data)).hexdigest()
    sent = previous.get("sent_at")
    return digest, (previous.get("digest") != digest or
                    not isinstance(sent, (int, float)) or
                    now < sent or now - sent >= HEARTBEAT_SECONDS)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def send(data, secret):
    body = encode(data)
    signature = hmac.new(secret.encode("utf-8"), body, hashlib.sha256).hexdigest()
    req = urllib.request.Request(ENDPOINT, data=body, method="POST",
                                 headers={"Content-Type": "application/json",
                                          "User-Agent": "mbligh-pvr-status/1.0",
                                          "X-Status-Signature": "sha256=" + signature})
    with urllib.request.build_opener(NoRedirect()).open(req, timeout=20) as response:
        reply = json.loads(response.read(8192))
        if response.status not in (200, 202) or reply.get("ok") is not True:
            raise RuntimeError("Dashboard rejected snapshot")
        if reply.get("ignored"):
            raise RuntimeError("Dashboard ignored older snapshot; check clocks")


def read_state(path):
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
        return state if isinstance(state, dict) else {}
    except (FileNotFoundError, ValueError):
        return {}


def save_state(path, state):
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                     delete=False) as tmp:
        try:
            json.dump(state, tmp)
            tmp.flush()
            os.fsync(tmp.fileno())
            os.replace(tmp.name, path)
        finally:
            Path(tmp.name).unlink(missing_ok=True)


def publish(db, state_path, secret, *, clock=time.time, transmit=send):
    state_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(str(state_path) + ".lock", "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return "busy"
        data = snapshot(db)
        now = clock()
        digest, changed = due(data, read_state(state_path), now)
        if not changed:
            return "unchanged"
        data["published_at"] = timestamp(dt.datetime.fromtimestamp(now, UTC))
        transmit(data, secret)
        # A failed request must never suppress the next retry.
        save_state(state_path, {"digest": digest, "sent_at": now})
        return "published"


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--database", default=os.getenv("MONGODB_DATABASE", "pvr"))
    parser.add_argument("--secret-file", type=Path,
                        default=Path.home() / ".auth/pvr-dashboard-secret")
    parser.add_argument("--state-file", type=Path,
                        default=Path.home() / ".cache/pvr/dashboard-status.json")
    args = parser.parse_args(argv)
    try:
        secret = None
        if args.apply:
            try:
                secret = args.secret_file.expanduser().read_text(encoding="utf-8").strip()
            except FileNotFoundError:
                print(f"Dashboard publisher: missing secret file {args.secret_file.expanduser()}",
                      file=sys.stderr)
                return 1
            if not secret:
                raise ValueError("Empty dashboard secret")
        with database_connection(args.database) as client:
            db = client[args.database]
            if args.apply:
                result = publish(db, args.state_file.expanduser(), secret)
                print(json.dumps({"type": "dashboard_status", "result": result}))
            else:
                data = snapshot(db)
                data["published_at"] = timestamp(dt.datetime.now(UTC))
                print(json.dumps(data, indent=2, ensure_ascii=False))
        return 0
    except urllib.error.HTTPError as exc:
        # Report only fixed, safe diagnostics; never print arbitrary
        # response bodies, which may contain reflected request data.
        details = []
        if exc.headers:
            if exc.headers.get("cf-mitigated", "").lower() == "challenge":
                details.append("Cloudflare challenge")
            content_type = exc.headers.get_content_type()
            if content_type in ("text/html", "application/json", "text/plain"):
                details.append(content_type)
            if content_type == "application/json":
                try:
                    reply = json.loads(exc.read(8192))
                    reason = reply.get("error") if isinstance(reply, dict) else None
                    if reason in ("Invalid signature", "Not configured",
                                  "Unknown group", "Invalid or expired snapshot",
                                  "Body too large", "Internal error"):
                        details.append(reason)
                except (OSError, ValueError):
                    pass
            ray = exc.headers.get("cf-ray", "")
            if ray and len(ray) <= 40 and all(c.isalnum() or c == "-" for c in ray):
                details.append("CF-Ray " + ray)
        suffix = " (" + "; ".join(details) + ")" if details else ""
        print(f"Dashboard publisher: HTTP {exc.code}{suffix}", file=sys.stderr)
    except Exception as exc:
        # Do not print arbitrary exceptions: credentials can be present in
        # connection diagnostics. The cron log receives a safe error type.
        print(f"Dashboard publisher: {type(exc).__name__}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
