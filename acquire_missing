#!/usr/bin/env python3
"""Acquire missing rugby recordings with bounded provider selection.

Preview-first. Optional --refresh performs source discovery and matching;
--apply downloads/compares at most --max-candidates per due episode and
canonically files the winner, without replacing published media.
"""
import argparse
import contextlib
import fcntl
import importlib.machinery
import importlib.util
import io
import json
import os
import pathlib
import sys

from orchestration.acquire import SOURCES, host_name, planning_rows
from matchers.pwr import SERIES_ID
from matchers.rugbypass import SERIES as INTERNATIONAL_SERIES
from selection.quality import select_episode


def _load_cli(name, filename):
    source = pathlib.Path(__file__).resolve().parent / filename
    loader = importlib.machinery.SourceFileLoader(name, str(source))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


download_release = _load_cli("pvr_acquire_downloader", "download_release")
file_recording = _load_cli("pvr_acquire_filer", "file_recording")


@contextlib.contextmanager
def acquire_lock(incoming_root):
    """Prevent overlapping host-local acquisition runs (including refresh)."""
    lock_path = pathlib.Path(incoming_root) / ".pvr-acquire.lock"
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(lock_path, flags, 0o600)
    with os.fdopen(fd, "r+") as lockfile:
        try:
            fcntl.flock(lockfile.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("Another PVR acquisition worker is running") from exc
        yield


def run(database, *, apply=False, limit=1, season=None, series_id=SERIES_ID,
        sports_root="/data/sports", incoming_root="/data/incoming",
        hostname=None, min_age_hours=3, retry_after_hours=6,
        max_candidates=3, sources=SOURCES,
        refresh=False, refresh_fn=None, youtube_limit=100, bbc_pages=10,
        rugbypass_pages=5, yt_dlp="yt-dlp", get_iplayer="get_iplayer",
        rugbypass="~/tools/video/rugbypass", ffmpeg="ffmpeg",
        ffprobe="ffprobe", show_skipped=False,
        downloader=download_release.run, filer=file_recording.run,
        selector=select_episode, stream=sys.stdout,
        summary_stream=sys.stderr, now=None):
    if not 1 <= limit <= 100 or not 1 <= max_candidates <= 5:
        raise ValueError("--limit must be 1..100 and --max-candidates 1..5")
    if min_age_hours < 0 or retry_after_hours < 0:
        raise ValueError("Negative age/retry delay")
    hostname = host_name(hostname)
    sources = tuple(dict.fromkeys(sources))
    if not sources or any(source not in SOURCES for source in sources):
        raise ValueError("Invalid acquisition source")
    if series_id not in (SERIES_ID, *INTERNATIONAL_SERIES):
        raise ValueError("Unsupported acquisition series")
    if series_id != SERIES_ID and sources != ("rugbypass",):
        raise ValueError("International/Nations acquisition supports RugbyPass only")

    def execute():
        refresh_result = None
        if refresh:
            # Preview fetches catalogue data but deliberately does not write
            # matches. The subsequent plan uses currently stored Atlas links.
            active_refresher = refresh_fn or _load_cli(
                "pvr_acquire_refresh", "refresh_releases").run
            refresh_result = active_refresher(
                database, apply=apply, sources=sources,
                youtube_limit=youtube_limit, bbc_pages=bbc_pages,
                rugbypass_pages=rugbypass_pages,
                rugbypass=rugbypass, yt_dlp=yt_dlp,
                output=io.StringIO())
            print(json.dumps(dict(type="refresh", **refresh_result), sort_keys=True),
                  file=stream)

        rows, info = planning_rows(
            database, sports_root=sports_root, incoming_root=incoming_root,
            season=season, series_id=series_id,
            hostname=hostname, min_age_hours=min_age_hours,
            retry_after_hours=retry_after_hours,
            max_candidates=max_candidates, sources=sources, now=now)
        actionable = [r for r in rows if r["action"] != "skip"]
        count = 0
        totals = {"filed": 0, "downloaded": 0, "failed": 0, "skipped_on_apply": 0}
        for row in rows:
            if row["action"] == "skip":
                if show_skipped:
                    print(json.dumps(dict(row, mode="preview"), sort_keys=True), file=stream)
                continue
            if count >= limit:
                continue
            count += 1
            if not apply:
                print(json.dumps(dict(row, mode="preview"), sort_keys=True), file=stream)
                continue
            try:
                downloads = (
                    row["downloads"] if row["action"] == "download_candidates_then_file"
                    else [{"source_uri": row["source_uri"], "incoming": row["incoming"]}]
                    if row["action"] == "download_then_file" else []
                )
                incomplete = False
                for candidate in downloads:
                    result = downloader(
                        database, candidate["source_uri"], candidate["incoming"],
                        hostname=hostname, yt_dlp=yt_dlp,
                        get_iplayer=get_iplayer, rugbypass=rugbypass,
                        ffmpeg=ffmpeg, ffprobe=ffprobe,
                        allow_existing_episode=True,
                        apply=True, output=io.StringIO())
                    if result["status"] != "downloaded":
                        totals["skipped_on_apply"] += 1
                        totals["failed"] += 1  # incomplete source comparison must exit nonzero
                        print(json.dumps(dict(row, mode="apply",
                                              status="download_skipped",
                                              source_uri=candidate["source_uri"],
                                              detail=result["status"]),
                                         sort_keys=True), file=stream)
                        incomplete = True
                        break
                    totals["downloaded"] += 1
                if incomplete:
                    # Do not file based on only some of the remote candidates.
                    break
                if downloads:
                    # Re-read all media candidates after downloads and rank
                    # their actual sizes/FPS rather than expected source quality.
                    choice = selector(database, row["episode_id"], hostname)
                    source = choice["preferred_path"]
                    if not source:
                        totals["skipped_on_apply"] += 1
                        print(json.dumps(dict(row, mode="apply",
                                              status="no_eligible_recording"),
                                         sort_keys=True), file=stream)
                        continue
                else:
                    source = row["source"]
                result = filer(database, source, sports_root=sports_root,
                               hostname=hostname, ffprobe=ffprobe, apply=True,
                               stream=io.StringIO())
                if result["status"] == "filed":
                    totals["filed"] += 1
                else:
                    totals["skipped_on_apply"] += 1
                print(json.dumps(dict(row, mode="apply",
                                      status=result["status"],
                                      selected_source=source,
                                      download_count=len(downloads)),
                                 sort_keys=True), file=stream)
            except Exception as exc:
                totals["failed"] += 1
                print(json.dumps(dict(row, mode="apply", status="failed",
                                      error=str(exc)[:1000]), sort_keys=True),
                      file=stream)
                # A failure may have left local candidates that need
                # reconciliation. Do not promote a partial comparison.
                break
        report = {
            "mode": "apply" if apply else "preview", "series": series_id,
            "host": hostname, "season": season, "limit": limit,
            "max_candidates": max_candidates, "sources": list(sources),
            "refreshed": refresh, "fixtures": info["fixtures"], "due": info["due"],
            "actionable": len(actionable), "planned": count,
            "skipped": len(rows) - len(actionable), **totals,
        }
        print(json.dumps(report, sort_keys=True), file=summary_stream)
        return report

    if apply:
        with acquire_lock(incoming_root):
            return execute()
    return execute()


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--series", choices=(SERIES_ID, *INTERNATIONAL_SERIES),
                        default=SERIES_ID,
                        help="Fixture series (default Rugby_Womens_PWR)")
    parser.add_argument("--season", type=int,
                        help="Season to acquire; default latest fixtures first")
    parser.add_argument("--limit", type=int, default=1,
                        help="Maximum episodes per run (default 1)")
    parser.add_argument("--max-candidates", type=int, default=3,
                        help="Maximum local and remote candidates per episode (default 3)")
    parser.add_argument("--source", choices=SOURCES, action="append",
                        help="Limit acquisition/refresh to this source; repeatable")
    parser.add_argument("--refresh", action="store_true",
                        help="First discover and match releases; preview never writes Atlas")
    parser.add_argument("--youtube-limit", type=int, default=100)
    parser.add_argument("--bbc-pages", type=int, default=10)
    parser.add_argument("--rugbypass-pages", type=int, default=5)
    parser.add_argument("--sports-root", default="/data/sports")
    parser.add_argument("--incoming-root", default="/data/incoming")
    parser.add_argument("--host", help="Local inventory host (default hostname)")
    parser.add_argument("--min-age-hours", type=float, default=3)
    parser.add_argument("--retry-after-hours", type=float, default=6)
    parser.add_argument("--show-skipped", action="store_true")
    parser.add_argument("--yt-dlp", default="yt-dlp")
    parser.add_argument("--get-iplayer", default="get_iplayer")
    parser.add_argument("--rugbypass", default="~/tools/video/rugbypass")
    parser.add_argument("--ffmpeg", default="ffmpeg")
    parser.add_argument("--ffprobe", default="ffprobe")
    parser.add_argument("--apply", action="store_true",
                        help="Download/compare/file; default preview-only")
    parser.add_argument("--database", default=os.environ.get("MONGODB_DATABASE", "pvr"))
    args = parser.parse_args(argv)
    if (not 1 <= args.limit <= 100 or not 1 <= args.max_candidates <= 5 or
            (args.season is not None and args.season < 2025)):
        parser.error("Provide --limit 1..100, --max-candidates 1..5, --season >=2025")
    uri = os.environ.get("MONGODB_URI")
    if not uri:
        try:
            uri = (pathlib.Path.home() / ".mongodb" / "pvr").read_text().strip()
        except OSError as exc:
            parser.error(f"Cannot read MongoDB URI: {exc}")
    if not uri:
        parser.error("Empty MongoDB URI")
    from pymongo import MongoClient
    try:
        with MongoClient(uri, serverSelectionTimeoutMS=15000) as client:
            client.admin.command("ping")
            report = run(
                client[args.database], apply=args.apply,
                limit=args.limit, season=args.season, series_id=args.series,
                sources=args.source or (
                    SOURCES if args.series == SERIES_ID else ("rugbypass",)),
                max_candidates=args.max_candidates,
                refresh=args.refresh, youtube_limit=args.youtube_limit,
                bbc_pages=args.bbc_pages, rugbypass_pages=args.rugbypass_pages,
                sports_root=args.sports_root, incoming_root=args.incoming_root,
                hostname=args.host, min_age_hours=args.min_age_hours,
                retry_after_hours=args.retry_after_hours,
                yt_dlp=args.yt_dlp, get_iplayer=args.get_iplayer,
                rugbypass=args.rugbypass, ffmpeg=args.ffmpeg,
                ffprobe=args.ffprobe, show_skipped=args.show_skipped)
    except Exception as exc:
        print(f"PVR acquisition: {exc}", file=sys.stderr)
        return 1
    return 1 if report["failed"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
