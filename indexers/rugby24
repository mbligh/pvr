#!/usr/bin/env python3
"""Index Rugby24 full-match replays with validated OK.ru embeds. JSONL output."""
import argparse
from datetime import datetime, timezone, timedelta
from html.parser import HTMLParser
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from urllib.parse import urljoin, urlsplit

DEFAULT_URL = "https://rugby24.net/premiership-rugby"
CHAMPIONS_URL = "https://rugby24.net/champions-cup"
CATEGORY_URLS = (DEFAULT_URL, CHAMPIONS_URL)
CATEGORIES = {"prem": DEFAULT_URL, "championship": CHAMPIONS_URL}
CHAMPIONS = re.compile(r"\b(?:european\s+)?champions\s+cup\b", re.I)
CHALLENGE = re.compile(r"\bchallenge\s+cup\b", re.I)
SLUG = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
EMBED = re.compile(r"(?:https?:)?//ok\.ru/videoembed/(\d{5,20})", re.I)
DATE = re.compile(r"\b(\d{1,2}\s+[A-Za-z]+\s+\d{4})\b")
FULL = re.compile(r"\bfull match replay\b", re.I)
CUP = re.compile(r"\b(?:prem(?:iership)? rugby cup|premiership cup)\b", re.I)
USER_AGENT = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
              "(KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36")
MAX_HTML_BYTES = 2_000_000


def init_cookie_jar(path):
    """Seed a temporary private jar from browser-exported Netscape cookies."""
    source = os.environ.get("RUGBY24_COOKIE_JAR")
    if not source:
        return
    cookie_file = Path(source).expanduser()
    if not cookie_file.is_file():
        raise ValueError("RUGBY24_COOKIE_JAR must name an existing cookies.txt file")
    shutil.copyfile(cookie_file, path)
    path.chmod(0o600)


def safe_rugby24_url(url):
    """Accept HTTP(S) only on rugby24.net, with no credentials or non-default port."""
    parsed = urlsplit(url)
    if (parsed.scheme not in ("https", "http")
            or parsed.hostname != "rugby24.net"
            or parsed.username or parsed.password or parsed.port
            or parsed.fragment):
        raise ValueError("Refusing non-Rugby24 redirect URL")
    return parsed.geturl()


def fetch_html(url, *, cookie_jar, execute=subprocess.run):
    """Fetch Rugby24, following only checked same-host HTTP(S) redirects.

    The site can redirect an HTTPS request to an HTTP URL at exactly the
    same path. Honor that redirect instead of looping back to HTTPS.
    Curl never follows redirects automatically: each hop is validated,
    uses the shared cookie jar, and allows just its requested protocol.
    """
    if urlsplit(url).scheme != "https":
        raise ValueError("Refusing non-Rugby24 URL")
    try:
        current = safe_rugby24_url(url)
    except ValueError as exc:
        raise ValueError("Refusing non-Rugby24 URL") from exc
    seen = set()
    with tempfile.TemporaryDirectory(prefix="pvr-rugby24-page-") as temporary:
        body_path = Path(temporary) / "response.html"
        header_path = Path(temporary) / "headers.txt"
        for hop in range(6):
            if current in seen:
                raise RuntimeError("Rugby24 redirect loop at " + urlsplit(current).path)
            seen.add(current)
            if hop:
                time.sleep(0.5)
            command = [
                "curl", "--silent", "--show-error", "--compressed",
                "--max-time", "30", "--max-filesize", str(MAX_HTML_BYTES),
                "--proto", "=" + urlsplit(current).scheme,
                "--user-agent", os.environ.get("RUGBY24_USER_AGENT") or USER_AGENT,
                "--header", "Accept: text/html",
                "--cookie", str(cookie_jar), "--cookie-jar", str(cookie_jar),
                "--dump-header", str(header_path),
                "--output", str(body_path),
                "--write-out", "%{http_code}|%{url_effective}",
                current,
            ]
            result = execute(command, capture_output=True, text=True, check=False)
            if result.returncode:
                error = result.stderr.strip()[:250]
                raise RuntimeError(
                    f"Rugby24 curl failed ({result.returncode}) "
                    f"at {urlsplit(current).path}: {error}"
                )
            details = result.stdout.split("|", 1)
            if len(details) != 2 or not details[0].isdigit():
                raise RuntimeError("Rugby24 curl did not return HTTP status and final URL")
            status = int(details[0])
            if details[1] != current:
                raise RuntimeError("Rugby24 curl unexpectedly redirected to another URL; refusing content")
            headers = header_path.read_text(errors="replace") if header_path.exists() else ""

            def header(name):
                values = []
                for line in headers.splitlines():
                    key, separator, value = line.partition(":")
                    if separator and key.casefold() == name:
                        values.append(value.strip()[:1000])
                return values[-1] if values else ""

            if status in (301, 302, 303, 307, 308):
                location = header("location")
                if not location:
                    raise RuntimeError("Rugby24 redirect is missing a Location header")
                try:
                    current = safe_rugby24_url(urljoin(current, location))
                except ValueError as exc:
                    raise RuntimeError(
                        "Rugby24 redirected to a different host; refusing content"
                    ) from exc
                continue
            if status != 200:
                server = header("server")[:80] or "unknown"
                challenge = header("cf-mitigated")[:80]
                path = urlsplit(current).path
                if status == 403 and challenge.casefold() == "challenge":
                    raise RuntimeError(
                        "Rugby24 Cloudflare challenge (HTTP 403) at " + path
                        + "; browser access required. RUGBY24_COOKIE_JAR and "
                        "RUGBY24_USER_AGENT may reuse valid browser clearance."
                    )
                raise RuntimeError(
                    f"Rugby24 HTTP {status} at {path} (server={server}"
                    + (f", cf-mitigated={challenge}" if challenge else "")
                    + "); check whether the site is accessible with curl from this host"
                )
            if not body_path.exists():
                raise RuntimeError("Rugby24 curl returned HTTP 200 without a response body")
            body = body_path.read_bytes()
            if len(body) > MAX_HTML_BYTES:
                raise ValueError("Rugby24 page too large")
            return body.decode("utf-8", errors="replace")
    raise RuntimeError("Rugby24 exceeded five redirects")


def fetch_page(url, *, cookie_jar, execute=subprocess.run):
    """Use cf-curl for Rugby24 if installed; keep curl-only as a fallback.

    The Debian-packaged /usr/bin/cf-curl manages its own private clearance
    cache, with /usr/bin/cfsolve and the packaged browser profile. Its
    redirect guard, HTTP error handling and response cap preserve discovery.
    RUGBY24_CF_CURL overrides the executable; 'off' forces legacy curl.
    If the Debian package is absent, fall back to the legacy curl transport.
    """
    if urlsplit(url).scheme != "https":
        raise ValueError("Refusing non-Rugby24 URL")
    try:
        safe_rugby24_url(url)
    except ValueError as exc:
        raise ValueError("Refusing non-Rugby24 URL") from exc

    configured = os.environ.get("RUGBY24_CF_CURL")
    if configured is not None and configured.casefold() in ("off", "0", "false"):
        return fetch_html(url, cookie_jar=cookie_jar, execute=execute)
    if configured is None:
        # Use the Debian package, not a source checkout or a PATH entry
        # that might shadow it (e.g. an older /usr/local installation).
        configured = "/usr/bin/cf-curl"
    binary = Path(configured).expanduser()
    if not binary.is_file():
        if "RUGBY24_CF_CURL" in os.environ:
            raise RuntimeError("Configured Rugby24 cf-curl is missing: " + str(binary))
        return fetch_html(url, cookie_jar=cookie_jar, execute=execute)
    if not os.access(binary, os.X_OK):
        raise RuntimeError("Rugby24 cf-curl is not executable: " + str(binary))

    with tempfile.TemporaryDirectory(prefix="pvr-rugby24-cf-curl-") as temporary:
        body_path = Path(temporary) / "response.html"
        command = [
            str(binary), "-L", "--compressed",
            "--max-time", "90", "--max-filesize", str(MAX_HTML_BYTES),
            "--allowed-host", "rugby24.net", "--fail",
            "-H", "Accept: text/html", "-o", str(body_path), url,
        ]
        options = {"capture_output": True, "text": True, "check": False}
        if binary == Path("/usr/bin/cf-curl"):
            # Ensure cf-curl invokes the binary and browser profile installed
            # by the same Debian package, even if /usr/local/bin precedes
            # /usr/bin on PATH. Leave explicit wrapper overrides alone.
            options["env"] = {
                **os.environ,
                "CFSOLVE_BIN": "/usr/bin/cfsolve",
                "CFSOLVE_PROFILE":
                    "/usr/share/cfsolve/profiles/safari-26-ios.json",
            }
        result = execute(command, **options)
        if result.returncode:
            # cf-curl never writes cookie values to stderr, but limit how
            # much upstream diagnostic text enters polling logs.
            detail = result.stderr.strip()[:300]
            raise RuntimeError(
                "Rugby24 cf-curl failed at " + urlsplit(url).path
                + (": " + detail if detail else f" (exit {result.returncode})"))
        if not body_path.is_file() or not body_path.stat().st_size:
            raise RuntimeError("Rugby24 cf-curl returned no HTML")
        data = body_path.read_bytes()
        if len(data) > MAX_HTML_BYTES:
            raise ValueError("Rugby24 page too large")
        return data.decode("utf-8", errors="replace")

def article_slug(url):
    parts = urlsplit(url)
    if (parts.scheme != "https" or parts.hostname != "rugby24.net"
            or parts.username or parts.password or parts.port or parts.query
            or parts.fragment):
        return None
    path = parts.path.strip("/")
    return path if SLUG.fullmatch(path) and len(path) <= 128 else None


class ListingParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.in_heading = False
        self.href = None
        self.words = []
        self.entries = []

    def handle_starttag(self, tag, attrs):
        if tag == "h3":
            self.in_heading = True
        elif tag == "a" and self.in_heading and self.href is None:
            self.href = dict(attrs).get("href")
            self.words = []

    def handle_data(self, data):
        if self.href is not None:
            self.words.append(data)

    def handle_endtag(self, tag):
        if tag == "a" and self.href is not None:
            self.entries.append((self.href, " ".join("".join(self.words).split())))
            self.href = None
            self.words = []
        elif tag == "h3":
            self.in_heading = False


class EmbedParser(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.embeds = []

    def handle_starttag(self, tag, attrs):
        if tag != "iframe":
            return
        for key, value in attrs:
            if key in ("src", "data-src") and value:
                match = EMBED.fullmatch(value.strip())
                if match:
                    self.embeds.append("https://ok.ru/videoembed/" + match.group(1))


def listing(html, base_url):
    parser = ListingParser()
    parser.feed(html)
    entries = {}
    for href, title in parser.entries:
        url = urljoin(base_url, href)
        slug = article_slug(url)
        kind = competition(title)
        category = urlsplit(base_url).path.rstrip("/")
        if (slug and FULL.search(title)
                and ((category == "/champions-cup" and kind == "champions-cup")
                     or (category == "/premiership-rugby"
                         and kind in ("league", "cup")))):
            entries[url] = title
    return entries


def embed_url(html):
    parser = EmbedParser()
    parser.feed(html)
    if parser.embeds:
        return parser.embeds[0]
    match = EMBED.search(html)
    return "https://ok.ru/videoembed/" + match.group(1) if match else None


def competition(title):
    if CHALLENGE.search(title):
        return "unknown"
    if CHAMPIONS.search(title):
        return "champions-cup"
    if CUP.search(title):
        return "cup"
    if re.search(r"\b(?:prem rugby|premiership rugby|gallagher prem)\b", title, re.I):
        return "league"
    return "unknown"


def match_date(title):
    matches = list(DATE.finditer(title))
    if not matches:
        return None
    try:
        return datetime.strptime(matches[-1].group(1), "%d %B %Y").date().isoformat()
    except ValueError:
        return None


def discover(url=DEFAULT_URL, *, pages=2, fetch=None, cached=None, now=None):
    if not 1 <= pages <= 25:
        raise ValueError("Rugby24 pages must be between 1 and 25")
    if urlsplit(url).scheme != "https" or urlsplit(url).hostname != "rugby24.net":
        raise ValueError("Rugby24 listing must be on https://rugby24.net")
    if fetch is None:
        with tempfile.TemporaryDirectory(prefix="pvr-rugby24-cookies-") as temporary:
            cookie_jar = Path(temporary) / "cookies.txt"
            init_cookie_jar(cookie_jar)
            calls = [0]

            def curl_fetch(page_url):
                if calls[0]:
                    time.sleep(0.5)
                calls[0] += 1
                return fetch_page(page_url, cookie_jar=cookie_jar)

            return discover(url, pages=pages, fetch=curl_fetch,
                            cached=cached, now=now)
    entries = {}
    for page in range(1, pages + 1):
        page_url = url if page == 1 else url.split("?")[0] + "?page" + str(page)
        found = listing(fetch(page_url), page_url)
        if not found:
            raise ValueError("Rugby24 listing contained no full-match entries: " + page_url)
        entries.update(found)
    releases = []
    now = now or datetime.now(timezone.utc)
    if now.tzinfo is None:
        raise ValueError("Rugby24 cache clock must be timezone-aware")
    cached = cached or {}
    for page_url, title in entries.items():
        slug = article_slug(page_url)
        uri = "rugby24:" + slug
        kind = competition(title)
        date = match_date(title)
        known = cached.get(uri) or {}
        prior = known.get("metadata") or {}
        old_embed = prior.get("embed_url")
        checked_at = prior.get("embed_checked_at")
        checked = None
        if isinstance(checked_at, str):
            try:
                checked = datetime.fromisoformat(checked_at.replace("Z", "+00:00"))
                if checked.tzinfo is None or checked > now:
                    checked = None
            except ValueError:
                pass
        # Revalidate only recent recordings, no more than once per week.
        # An existing known older replay is stable; retries on it add no value.
        recent = False
        if date:
            age = (now.date() - datetime.fromisoformat(date).date()).days
            recent = -2 <= age <= 30
        stale = recent and checked is not None and now - checked >= timedelta(days=7)
        reuse = (
            known.get("source") == "rugby24"
            and known.get("id") == slug
            and prior.get("page_url") == page_url
            and prior.get("competition") == kind
            and isinstance(old_embed, str)
            and EMBED.fullmatch(old_embed) is not None
            and (known.get("availability_check") or {}).get("status") != "unavailable"
            and not stale
        )
        if reuse:
            embed = old_embed
            checked_time = checked or now
        else:
            embed = embed_url(fetch(page_url))
            checked_time = now
        if not embed:
            continue  # Unplayable articles must not become download candidates.
        row = {"source": "rugby24", "id": slug, "uri": uri,
               "title": title, "type": "episode", "available": True,
               "metadata": {"page_url": page_url, "embed_url": embed,
                            "embed_checked_at": checked_time.isoformat(),
                            "competition": kind, "date_basis": "title"}}
        if date:
            row["published"] = date
        releases.append(row)
    if not releases:
        raise ValueError("Rugby24 listing had no entries with OK.ru embeds")
    return releases


def discover_all(*, pages=2, category="both", fetch=None, cached=None, now=None):
    """Scan selected categories, sharing site cookies and a request budget.

    Each category is fetched independently and only validated full-match
    articles with OK.ru embeds are emitted. A category failure fails the
    whole scan instead of silently treating its matches as unavailable.
    """
    if category not in ("both", "prem", "championship"):
        raise ValueError("Unsupported Rugby24 category")
    if fetch is None:
        with tempfile.TemporaryDirectory(prefix="pvr-rugby24-cookies-") as temporary:
            cookie_jar = Path(temporary) / "cookies.txt"
            init_cookie_jar(cookie_jar)
            calls = [0]

            def shared_fetch(url):
                if calls[0]:
                    time.sleep(0.5)
                calls[0] += 1
                return fetch_page(url, cookie_jar=cookie_jar)

            return discover_all(pages=pages, category=category, fetch=shared_fetch,
                                cached=cached, now=now)
    rows = {}
    targets = CATEGORY_URLS if category == "both" else (CATEGORIES[category],)
    for target in targets:
        for row in discover(target, pages=pages, fetch=fetch,
                            cached=cached, now=now):
            uri = row["uri"]
            if uri in rows and rows[uri] != row:
                raise ValueError("Conflicting Rugby24 article across categories: " + uri)
            rows[uri] = row
    return list(rows.values())


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--url", help="Optional one-category URL (default: both supported categories)")
    parser.add_argument("--category", choices=("both", "prem", "championship"),
                        default="both")
    parser.add_argument("--pages", type=int, default=2,
                        help="Pages per category, not total pages")
    parser.add_argument("--search", help="Only output titles containing this text")
    args = parser.parse_args(argv)
    if args.url and args.category != "both":
        parser.error("--url and --category cannot be combined")
    try:
        rows = (discover(args.url, pages=args.pages) if args.url
                else discover_all(pages=args.pages, category=args.category))
    except (OSError, ValueError, RuntimeError) as exc:
        print("Rugby24 indexer: " + str(exc), file=sys.stderr)
        return 1
    for row in rows:
        if not args.search or args.search.casefold() in row["title"].casefold():
            print(json.dumps(row, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
