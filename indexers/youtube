#!/usr/bin/env python3
"""PWR channel streams and full-match playlist indexer using local yt-dlp.

Resolve metadata for channel streams first, then enumerate the curated full-match
playlist cheaply and resolve only video IDs absent from the stream listing.
Use --flat for fast catalogue browsing when dates are not needed.
"""
import argparse
import datetime as dt
import json
import re
import subprocess
import sys

DEFAULT_URL = "https://www.youtube.com/@ThePWROfficial/streams"
FULL_MATCH_PLAYLIST = "https://www.youtube.com/playlist?list=PL6NsZFkjlRqEZH4Pi5o9RoHfIfwzeo04l"
VIDEO_ID = re.compile(r"^[A-Za-z0-9_-]{11}$")
COMPACT_DATE = re.compile(r"^\d{8}$")
# A future scheduled livestream can raise an extraction error even with
# --ignore-errors. Treat only this precise YouTube error as an expected skip.
UPCOMING_ERROR = re.compile(
    r"^ERROR: \[youtube\] [A-Za-z0-9_-]{11}: This live event will begin in .+$"
)


def expected_upcoming_failures(stderr):
    """Count known upcoming-stream errors; reject all other extraction errors."""
    errors = [line.strip() for line in stderr.splitlines()
              if line.strip().startswith("ERROR:")]
    if not errors or not all(UPCOMING_ERROR.fullmatch(error) for error in errors):
        return None
    return len(errors)


def date_from_metadata(video):
    """Return (ISO date/time, source field) from yt-dlp's most relevant date.

    The start of a past livestream usually corresponds better to the fixture
    date than the subsequent processing/upload time. Preserve the source so
    matching can account for different meanings and timezones.
    """
    for field in ("release_timestamp", "release_date", "timestamp", "upload_date"):
        value = video.get(field)
        if field.endswith("timestamp"):
            if isinstance(value, (int, float)) and not isinstance(value, bool) and value > 0:
                try:
                    return dt.datetime.fromtimestamp(value, dt.timezone.utc).isoformat(), field
                except (OverflowError, OSError, ValueError):
                    continue
        elif isinstance(value, str) and COMPACT_DATE.fullmatch(value):
            try:
                return dt.datetime.strptime(value, "%Y%m%d").date().isoformat(), field
            except ValueError:
                continue
    return None, None


def convert_video(video):
    if not isinstance(video, dict):
        return None
    video_id = video.get("id")
    title = video.get("title")
    if not isinstance(video_id, str) or not VIDEO_ID.fullmatch(video_id):
        return None
    if not isinstance(title, str) or not title.strip():
        return None
    status = video.get("live_status")
    if status in ("is_live", "is_upcoming", "post_live"):
        return None  # Do not treat incomplete streams as finished recordings.
    record = {
        "source": "youtube",
        "id": video_id,
        "uri": "youtube:" + video_id,
        "title": title.strip(),
        "type": "video",
    }
    # A flat listing can omit live_status. Do not falsely claim that an
    # unknown-status entry is a completed replay.
    if status in ("was_live", "not_live"):
        record["available"] = True
    metadata = {}
    for field in ("live_status", "channel", "channel_id", "uploader", "webpage_url"):
        if isinstance(video.get(field), str):
            metadata[field] = video[field]
    if isinstance(video.get("duration"), (int, float)):
        record["duration"] = video["duration"]
    for field in ("release_timestamp", "timestamp", "release_date", "upload_date"):
        value = video.get(field)
        if (isinstance(value, str) or
                (isinstance(value, (int, float)) and not isinstance(value, bool))):
            metadata[field] = value
    date, basis = date_from_metadata(video)
    if date:
        record["published"] = date
        metadata["date_basis"] = basis
    if metadata:
        record["metadata"] = metadata
    return record


def discover(url=DEFAULT_URL, *, search=None, limit=100, binary="yt-dlp",
             flat=False, execute=subprocess.run):
    if not url.startswith("https://www.youtube.com/"):
        raise ValueError("Only HTTPS YouTube channel and playlist URLs are supported")
    # yt-dlp --dump-json outputs one JSON object per video. Without --flat-playlist
    # it resolves the complete metadata for each entry; --skip-download prevents
    # any media transfer. Live streams and unavailable entries are filtered below.
    command = [binary, "--dump-json", "--skip-download", "--ignore-errors",
               "--playlist-end", str(limit), "--no-warnings"]
    if flat:
        command.append("--flat-playlist")
    command.append(url)
    result = execute(command, capture_output=True, text=True, check=False)
    if result.returncode:
        skipped = expected_upcoming_failures(result.stderr)
        if skipped is None:
            raise RuntimeError(f"yt-dlp exited {result.returncode}: {result.stderr.strip()[:500]}")
        print(f"YouTube: skipped {skipped} upcoming livestream(s)", file=sys.stderr)
    found = {}
    term = search.casefold() if search else ""
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        try:
            video = json.loads(line)
        except json.JSONDecodeError as exc:
            raise ValueError("yt-dlp emitted non-JSON output") from exc
        release = convert_video(video)
        if release and (not term or term in release["title"].casefold()):
            found[release["id"]] = release
    return list(found.values())


def discover_pwr(*, search=None, limit=100, binary="yt-dlp", flat=False,
                 execute=subprocess.run):
    """Index streams plus the curated full-match playlist without repeat lookups.

    The stream index retains its original metadata-rich behavior. A cheap flat
    playlist scan finds uploads omitted by /streams; only previously unseen IDs
    receive additional per-video metadata requests. Unfinished streams remain
    excluded and all records keep the normal youtube:<video-id> identity.
    """
    found = {item["id"]: item for item in discover(
        DEFAULT_URL, search=search, limit=limit, binary=binary,
        flat=flat, execute=execute)}
    playlist = discover(FULL_MATCH_PLAYLIST, search=search, limit=limit,
                        binary=binary, flat=True, execute=execute)
    for item in playlist:
        if item["id"] in found:
            continue
        if flat:
            found[item["id"]] = item
        else:
            url = "https://www.youtube.com/watch?v=" + item["id"]
            for detailed in discover(url, search=search, limit=1,
                                     binary=binary, execute=execute):
                found[detailed["id"]] = detailed
    return list(found.values())


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--url",
                        help="Override default PWR streams + full-match playlist with one URL")
    parser.add_argument("--search", help="Case-insensitive video title substring")
    parser.add_argument("--limit", type=int, default=100,
                        help="Maximum listed videos (default 100)")
    parser.add_argument("--yt-dlp", default="yt-dlp", help="yt-dlp executable")
    parser.add_argument("--flat", action="store_true",
                        help="Fast listing without fetching each video's dates")
    args = parser.parse_args(argv)
    if not 1 <= args.limit <= 5000:
        parser.error("--limit must be 1-5000")
    try:
        options = {"search": args.search, "limit": args.limit,
                   "binary": args.yt_dlp, "flat": args.flat}
        releases = (discover(args.url, **options) if args.url else
                    discover_pwr(**options))
    except (ValueError, OSError, RuntimeError) as exc:
        print(f"YouTube indexer: {exc}", file=sys.stderr)
        return 1
    for record in releases:
        print(json.dumps(record, ensure_ascii=False))
    missing = sum("published" not in record for record in releases)
    print(f"YouTube: {len(releases)} releases, {len(releases) - missing} dated"
          + (f", {missing} without dates" if missing else ""),
          file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
