#!/usr/bin/env python3
"""One-shot rugby release discovery, matching, and acquisition.

Default: read-only polling status and acquisition plan across all supported rugby.
--apply: per-indexer schedule-aware discovery/matching, then bounded acquisition.
Each indexer falls back to a daily check, with age-based event polling backoff.
--skip-discovery: acquire only releases already indexed in Atlas.
--force-discovery: bypass the successful-check cooldown manually.
Official fixture scheduling remains the separate import_rugby command.
"""
import argparse
import contextlib
import json
import os
from pathlib import Path
import subprocess
import sys

from orchestration import polling
from inventory import library as inventory
from orchestration.locks import LockBusy
from orchestration.source_registry import RUGBY_SERIES, RUGBY_SOURCES, sources_for
from matchers.pwr import SERIES_ID

ROOT = Path(__file__).resolve().parent


def command(script, *args):
    return [sys.executable, str(ROOT / script), *[str(arg) for arg in args]]



def source_set(series, sources):
    if series is not None and series not in RUGBY_SERIES:
        raise ValueError("Unsupported rugby series")
    allowed = RUGBY_SOURCES if series is None else sources_for(series)
    values = tuple(dict.fromkeys(sources or allowed))
    if not values or any(item not in allowed for item in values):
        if series in ("Rugby_Mens_Prem", "Rugby_Mens_Championship"):
            raise ValueError("Rugby24 only for the selected series")
        raise ValueError("RugbyPass only for international series; source not supported for selected series")
    return values


def run(*, apply=False, skip_discovery=False, force_discovery=False, series=None,
        season=None, round_no=None, episode_number=None, limit=1,
        max_candidates=3, sources=None,
        youtube_limit=100, bbc_pages=10, rugbypass_pages=5, rugby24_pages=2,
        sports_root="/data/sports", incoming_root="/data/incoming",
        hostname=None, min_age_hours=3, retry_after_hours=6,
        yt_dlp="yt-dlp", get_iplayer="get_iplayer",
        rugbypass="~/tools/video/rugbypass", ffmpeg="ffmpeg", ffprobe="ffprobe",
        show_skipped=False, database="pvr", poll_db=None, now=None,
        execute=subprocess.run, output=sys.stdout, error=sys.stderr):
    if not 1 <= limit <= 100 or not 1 <= max_candidates <= 5:
        raise ValueError("Invalid episode/candidate budget")
    if (season is not None and season < 2025) or (
            round_no is not None and not 1 <= round_no <= 99) or (
            episode_number is not None and episode_number < 1):
        raise ValueError("Invalid season, round or episode")
    if min_age_hours < 0 or retry_after_hours < 0:
        raise ValueError("Invalid minimum age or retry delay")
    if (not 1 <= youtube_limit <= 5000 or not 1 <= bbc_pages <= 20
            or not 1 <= rugbypass_pages <= 50 or not 1 <= rugby24_pages <= 25):
        raise ValueError("Invalid source discovery limits")
    if skip_discovery and force_discovery:
        raise ValueError("--skip-discovery conflicts with --force-discovery")
    sources = source_set(series, sources)
    if not Path(incoming_root).is_dir():
        raise ValueError("Incoming directory does not exist")

    def invoke(script, *args):
        result = execute(command(script, *args), capture_output=True,
                         text=True, check=False)
        if result.stdout:
            print(result.stdout, end="" if result.stdout.endswith("\n") else "\n",
                  file=output)
        if result.stderr:
            print(result.stderr, end="" if result.stderr.endswith("\n") else "\n",
                  file=error)
        return result

    def run_acquisitions(missing, *, apply):
        # One acquisition worker builds a globally newest-first fixture
        # queue. Per-series runs use the same worker with a narrower scope.
        if not any(event["series_id"] in RUGBY_SERIES
                   and any(source in sources_for(event["series_id"])
                           for source in sources)
                   for event in missing):
            return 0
        args = ["--limit", limit,
                "--max-candidates", max_candidates,
                "--sports-root", sports_root, "--incoming-root", incoming_root,
                "--min-age-hours", min_age_hours,
                "--retry-after-hours", retry_after_hours,
                "--yt-dlp", yt_dlp, "--get-iplayer", get_iplayer,
                "--rugbypass", rugbypass,
                "--ffmpeg", ffmpeg, "--ffprobe", ffprobe,
                "--database", database]
        if series is None:
            args.append("--all-series")
        else:
            args.extend(("--series", series))
        if season is not None:
            args.extend(("--season", season))
        if round_no is not None:
            args.extend(("--round", round_no))
        if episode_number is not None:
            args.extend(("--episode", episode_number))
        if hostname is not None:
            args.extend(("--host", hostname))
        if show_skipped:
            args.append("--show-skipped")
        for source in sources:
            if series is None or source in sources_for(series):
                args.extend(("--source", source))
        result = invoke("acquire_rugby", *args, *([ "--apply" ] if apply else []))
        if result.returncode:
            return result.returncode
        # A single worker owns the global --limit and reports attempts.
        try:
            reports = [json.loads(line) for line in result.stderr.splitlines()
                       if line.strip().startswith("{")]
            count = reports[-1]["planned"]
            if type(count) is not int or not 0 <= count <= limit:
                raise ValueError("Invalid planned count")
        except (ValueError, IndexError, KeyError, TypeError) as exc:
            raise RuntimeError("Rugby acquisition summary missing") from exc
        return 0

    def work():
        # Atlas reads are shared between preview, apply and --skip-discovery.
        if poll_db is None:
            client = polling.database_connection(database)
            scope = client
        else:
            scope = contextlib.nullcontext(poll_db)
        with scope as connection:
            db = connection[database] if poll_db is None else connection
            category_series = (
                ("prem", "Rugby_Mens_Prem"),
                ("championship", "Rugby_Mens_Championship"),
            )
            selected_category = next(
                (category for category, name in category_series if name == series),
                None,
            )
            state_keys = ({"rugby24": "rugby24:" + selected_category}
                          if selected_category and "rugby24" in sources else None)
            if apply:
                inventory.scan(
                    db, sports_root=sports_root, apply=True, series_ids=(series,) if series else
                               [name for name in inventory.SERIES_PATHS if name.startswith("Rugby_")],
                    hostname=hostname, ffprobe=ffprobe,
                    quiet=True, stream=output, summary_stream=output,
                    lock_root=incoming_root)
            decisions, missing = polling.plan(
                db, sources=sources, now=now, sports_root=sports_root,
                host=hostname, season=season,
                series_ids=(series,) if series is not None else None,
                round_no=round_no, episode_number=episode_number,
                state_keys=state_keys)
            # One Rugby24 category cannot advance the other category's
            # discovery timestamp. Plan both scopes independently for cron.
            jobs = []
            for source in sources:
                if source != "rugby24":
                    jobs.append((source, source, None, decisions[source]))
                elif selected_category:
                    jobs.append((source, "rugby24:" + selected_category,
                                 selected_category, decisions[source]))
                else:
                    for category, selected_series in category_series:
                        category_decisions, _ = polling.plan(
                            db, sources=("rugby24",), now=now,
                            sports_root=sports_root, host=hostname,
                            season=season, series_ids=(selected_series,),
                            round_no=round_no, episode_number=episode_number,
                            state_keys={"rugby24": "rugby24:" + category})
                        jobs.append((source, "rugby24:" + category,
                                     category, category_decisions["rugby24"]))
            status = []
            for source, state_key, category, decision in jobs:
                entry = polling.status_summary({source: decision})[0]
                entry["source"] = state_key
                status.append(entry)
            print(json.dumps({"type": "polling", "sources": status}, sort_keys=True),
                  file=output)
            if apply and not skip_discovery:
                category_failures = []
                for source, state_key, category, decision in jobs:
                    # A forced check bypasses the successful-check interval,
                    # but never bypasses a failure/challenge cooldown.
                    if decision.get("cooldown_active") or (
                            not decision["due"] and not force_discovery):
                        continue
                    args = ["--apply", "--source", source,
                            "--youtube-limit", youtube_limit, "--bbc-pages", bbc_pages,
                            "--rugbypass-pages", rugbypass_pages,
                            "--rugby24-pages", rugby24_pages,
                            "--yt-dlp", yt_dlp, "--rugbypass", rugbypass,
                            "--database", database, "--lock-root", incoming_root]
                    if category:
                        args.extend(("--rugby24-category", category))
                    result = None
                    try:
                        result = invoke("refresh_releases", *args)
                        if result.returncode == 75:
                            print(json.dumps({"type": "indexer_busy",
                                              "source": state_key}), file=output)
                            continue
                        if result.returncode:
                            raise RuntimeError("Discovery failed for " + state_key
                                               + "; refusing acquisition")
                        report = json.loads(result.stdout)
                        if (report.get("mode") != "apply" or
                                report.get("sources") != [source] or
                                type(report.get("total_releases")) is not int or
                                report["total_releases"] < 0):
                            raise RuntimeError("Invalid discovery report for " + state_key)
                        polling.record_success(db, state_key, now=now)
                    except Exception:
                        # The source wrapper reports Cloudflare's specific
                        # challenge without printing any session credentials.
                        challenged = (
                            source == "rugby24" and result is not None
                            and "cloudflare" in result.stderr.casefold()
                            and "challenge" in result.stderr.casefold()
                        )
                        polling.record_failure(
                            db, state_key, now=now,
                            reason="cloudflare_challenge" if challenged else None)
                        # In the unscoped cron run one Rugby24 category
                        # may fail without preventing a check of the other.
                        # Never acquire anything on a partial refresh.
                        if source == "rugby24" and series is None:
                            category_failures.append(state_key)
                            continue
                        raise
                if category_failures:
                    raise RuntimeError(
                        "Discovery failed for " + ", ".join(category_failures)
                        + "; refusing acquisition")
            if not missing:
                return 0
            return run_acquisitions(missing, apply=apply)

    # Never hold an indexer lock while acquisition is running.
    # acquire_rugby obtains episode locks and download_release owns
    # per-site download locks. Another cron invocation can continue indexing.
    return work()


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--series", choices=RUGBY_SERIES,
                        help="Restrict to one series (default: all supported rugby)")
    parser.add_argument("--season", "--year", type=int, dest="season",
                        help="Filter by season; fixtures always acquired newest first")
    parser.add_argument("--round", type=int, dest="round_no")
    parser.add_argument("--episode", type=int, dest="episode_number")
    parser.add_argument("--limit", type=int, default=1)
    parser.add_argument("--max-candidates", type=int, default=3)
    parser.add_argument("--source", choices=RUGBY_SOURCES, action="append",
                        help="Discovery and acquisition provider (repeatable)")
    parser.add_argument("--youtube-limit", type=int, default=100)
    parser.add_argument("--bbc-pages", type=int, default=10)
    parser.add_argument("--rugbypass-pages", type=int, default=5)
    parser.add_argument("--rugby24-pages", type=int, default=2)
    parser.add_argument("--sports-root", default="/data/sports")
    parser.add_argument("--incoming-root", default="/data/incoming")
    parser.add_argument("--host")
    parser.add_argument("--min-age-hours", type=float, default=3)
    parser.add_argument("--retry-after-hours", type=float, default=6)
    parser.add_argument("--yt-dlp", default="yt-dlp")
    parser.add_argument("--get-iplayer", default="get_iplayer")
    parser.add_argument("--rugbypass", default="~/tools/video/rugbypass")
    parser.add_argument("--ffmpeg", default="ffmpeg")
    parser.add_argument("--ffprobe", default="ffprobe")
    parser.add_argument("--show-skipped", action="store_true")
    parser.add_argument("--skip-discovery", action="store_true",
                        help="Do not refresh providers; use already indexed releases")
    parser.add_argument("--force-discovery", action="store_true",
                        help="Ignore successful poll cooldown (manual override)")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--apply", action="store_true",
                      help="Discover, index, match, download and file; default preview")
    mode.add_argument("--dry-run", action="store_true",
                      help="Preview only (already the default)")
    parser.add_argument("--database", default=os.environ.get("MONGODB_DATABASE", "pvr"))
    args = parser.parse_args(argv)
    try:
        return run(apply=args.apply, skip_discovery=args.skip_discovery,
                   force_discovery=args.force_discovery, series=args.series, season=args.season, round_no=args.round_no,
                   episode_number=args.episode_number, limit=args.limit,
                   max_candidates=args.max_candidates, sources=args.source,
                   youtube_limit=args.youtube_limit, bbc_pages=args.bbc_pages,
                   rugbypass_pages=args.rugbypass_pages,
                   rugby24_pages=args.rugby24_pages,
                   sports_root=args.sports_root, incoming_root=args.incoming_root,
                   hostname=args.host, min_age_hours=args.min_age_hours,
                   retry_after_hours=args.retry_after_hours, yt_dlp=args.yt_dlp,
                   get_iplayer=args.get_iplayer, rugbypass=args.rugbypass,
                   ffmpeg=args.ffmpeg, ffprobe=args.ffprobe,
                   show_skipped=args.show_skipped, database=args.database)
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"Rugby run: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
