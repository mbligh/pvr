#!/usr/bin/env python3
"""Inventory existing sports recordings across supported series.

Preview by default; --apply records verified media and creates missing NFOs.
Installed recordings and their NFOs are renamed to canonical filenames;
existing destinations are never overwritten.
"""
import argparse
import os
import pathlib
import sys

from inventory.library import scan as scan_library, persist, DEFAULT_ROOT
from inventory.scan import probe_video
from filing.publish import SERIES_PATHS


def scan(database, **kwargs):
    return scan_library(database, prober=probe_video, **kwargs)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", action="append", type=pathlib.Path,
                        help="Directory to scan; repeatable (default: all supported series under sports root)")
    parser.add_argument("--sports-root", default=DEFAULT_ROOT)
    parser.add_argument("--series", action="append", choices=sorted(SERIES_PATHS),
                        help="Restrict inventory to a series (repeatable)")
    parser.add_argument("--apply", action="store_true",
                        help="Write inventory, canonicalize filenames and create missing NFOs; default previews only")
    parser.add_argument("--no-probe", action="store_true",
                        help="Preview filename/NFO matching without ffprobe; cannot --apply")
    parser.add_argument("--ffprobe", default="ffprobe",
                        help="ffprobe command (default ffprobe)")
    parser.add_argument("--host", help="Host identifier in Atlas, default system hostname")
    parser.add_argument("--verbose", action="store_true",
                        help="Show unmatched and unmanaged historical video files too")
    parser.add_argument("--show-unseen", action="store_true",
                        help="List past episodes without an identified file in scanned roots")
    parser.add_argument("--database", default=os.environ.get("MONGODB_DATABASE", "pvr"))
    args = parser.parse_args(argv)
    if args.apply and args.no_probe:
        parser.error("--apply and --no-probe are mutually exclusive")
    mongo_uri = os.environ.get("MONGODB_URI")
    if not mongo_uri:
        path = pathlib.Path.home() / ".mongodb" / "pvr"
        try:
            mongo_uri = path.read_text(encoding="utf-8").strip()
        except OSError as exc:
            parser.error(f"Cannot read MongoDB URI from {path}: {exc}")
    if not mongo_uri:
        parser.error("MongoDB URI is empty")
    from pymongo import MongoClient
    try:
        with MongoClient(mongo_uri, serverSelectionTimeoutMS=15000) as client:
            client.admin.command("ping")
            scan(client[args.database], roots=args.root, apply=args.apply,
                 probe=not args.no_probe, ffprobe=args.ffprobe,
                 hostname=args.host, verbose=args.verbose,
                 show_unseen=args.show_unseen, sports_root=args.sports_root,
                 series_ids=args.series)
    except (OSError, ValueError) as exc:
        print(f"PVR inventory: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
