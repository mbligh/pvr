#!/usr/bin/env python3
"""Inventory existing PWR video files against MongoDB episodes and releases.

No file operations are performed. Default is preview-only; --apply persists
only unambiguous, ffprobe-verified files to pvr.files.
"""
import argparse
import collections
import datetime as dt
import json
import os
import pathlib
import socket
import sys

from inventory.scan import identify, make_indexes, probe_video, walk_videos
from matchers.pwr import SERIES_ID

DEFAULT_ROOT = "/data/sports/Rugby_Womens_PWR"


def scan(database, *, roots=None, apply=False, probe=True, ffprobe="ffprobe",
         hostname=None, verbose=False, stream=sys.stdout,
         summary_stream=sys.stderr):
    roots = list(roots) if roots is not None else [DEFAULT_ROOT]
    if not roots:
        raise ValueError("At least one scan root is required")
    if apply and not probe:
        raise ValueError("--apply requires ffprobe verification")
    hostname = hostname or socket.gethostname()
    if not hostname or ":" in hostname or "/" in hostname:
        raise ValueError("Invalid hostname for file identity")

    episodes = list(database.episodes.find(
        {"series_id": SERIES_ID, "season": {"$gte": 2025}},
        {"_id": 1, "series_id": 1, "season": 1, "episode": 1, "nfo_path": 1}
    ))
    if not episodes:
        raise ValueError("No PWR episodes found; import fixtures first")
    releases = list(database.releases.find(
        {"episode_id": {"$in": [ep["_id"] for ep in episodes]}},
        {"_id": 1, "episode_id": 1}
    ))
    by_number, linked = make_indexes(episodes, releases)
    counts = collections.Counter()
    rows = []
    now = dt.datetime.now(dt.timezone.utc)
    files_per_episode = collections.Counter()

    for path in walk_videos(roots):
        counts["scanned"] += 1
        episode, release_uri, evidence, reason = identify(path, by_number, linked)
        item = {"path": str(path.absolute())}
        if reason:
            item.update(status="conflict", reason=reason)
        elif episode is None:
            item["status"] = "unmatched"
        else:
            item.update(status="present" if probe else "unprobed",
                        episode_id=episode["_id"], season=episode["season"],
                        episode=episode["episode"], evidence=evidence)
            if release_uri:
                item["release_uri"] = release_uri
            try:
                before = path.stat()
                if not before.st_size:
                    raise ValueError("Empty media file")
                if probe:
                    media = probe_video(path, binary=ffprobe)
                    after = path.stat()
                    if (before.st_size, before.st_mtime_ns, before.st_ino) != (
                            after.st_size, after.st_mtime_ns, after.st_ino):
                        raise ValueError("Media file changed while probing")
                    item["media"] = media
                item["bytes"] = before.st_size
                item["mtime_ns"] = before.st_mtime_ns
                if probe:
                    data = {
                        "_id": f"{hostname}:{path.absolute()}",
                        "host": hostname,
                        "path": str(path.absolute()),
                        "episode_id": episode["_id"],
                        "series_id": SERIES_ID,
                        "season": episode["season"],
                        "episode": episode["episode"],
                        "match_evidence": evidence,
                        "release_uri": release_uri,
                        "size_bytes": before.st_size,
                        "mtime_ns": before.st_mtime_ns,
                        "media": media,
                        "last_seen": now,
                    }
                    rows.append(data)
                    files_per_episode[episode["_id"]] += 1
            except (OSError, ValueError) as exc:
                item["status"] = "probe_error"
                item["reason"] = str(exc)
                item.pop("media", None)
        counts[item["status"]] += 1
        if verbose or item["status"] != "unmatched":
            print(json.dumps(item, ensure_ascii=False), file=stream)

    # All filesystem observations are complete before any Atlas updates.
    if apply and rows:
        persist(database, rows, now=now)
    report = {
        "mode": "apply" if apply else "preview",
        "series": SERIES_ID, "roots": [str(r) for r in roots],
        "fixtures": len(episodes), "scanned": counts["scanned"],
        "present": counts["present"], "unprobed": counts["unprobed"],
        "unmatched": counts["unmatched"], "conflict": counts["conflict"],
        "probe_error": counts["probe_error"],
        "episodes_with_files": len(files_per_episode),
        "written": len(rows) if apply else 0,
    }
    print(json.dumps(report, sort_keys=True), file=summary_stream)
    return report


def persist(database, rows, *, now=None):
    """Idempotent, non-destructive upsert; refuse to reassign existing paths."""
    from pymongo import UpdateOne

    now = now or dt.datetime.now(dt.timezone.utc)
    ids = [r["_id"] for r in rows]
    if len(ids) != len(set(ids)):
        raise ValueError("Duplicate local file identities")
    previous = list(database.files.find({"_id": {"$in": ids}},
                                        {"_id": 1, "episode_id": 1}))
    expected = {r["_id"]: r["episode_id"] for r in rows}
    conflicts = [r["_id"] for r in previous if r.get("episode_id") not in
                 (None, expected[r["_id"]])]
    if conflicts:
        raise ValueError("Existing file associations conflict: " +
                         ", ".join(conflicts[:5]))

    database.files.create_index([("host", 1), ("path", 1)], unique=True)
    database.files.create_index([("episode_id", 1)])
    # A changed association between preflight and write triggers a duplicate
    # key error instead of silently replacing somebody else's episode link.
    operations = [
        UpdateOne(
            {"_id": row["_id"], "episode_id": {"$in": [None, row["episode_id"]]}},
            {"$set": {k: v for k, v in row.items() if k != "_id"},
             "$setOnInsert": {"first_seen": now}},
            upsert=True,
        )
        for row in rows
    ]
    if operations:
        database.files.bulk_write(operations, ordered=True)
    return len(operations)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", action="append", type=pathlib.Path,
                        help="Directory to scan; repeatable (default: /data/sports/Rugby_Womens_PWR)")
    parser.add_argument("--apply", action="store_true",
                        help="Write verified files to Atlas; default previews only")
    parser.add_argument("--no-probe", action="store_true",
                        help="Preview filename/NFO matching without ffprobe; cannot --apply")
    parser.add_argument("--ffprobe", default="ffprobe",
                        help="ffprobe command (default ffprobe)")
    parser.add_argument("--host", help="Host identifier in Atlas, default system hostname")
    parser.add_argument("--verbose", action="store_true",
                        help="Show unmatched video files too")
    parser.add_argument("--database", default=os.environ.get("MONGODB_DATABASE", "pvr"))
    args = parser.parse_args(argv)
    if args.apply and args.no_probe:
        parser.error("--apply and --no-probe are mutually exclusive")
    mongo_uri = os.environ.get("MONGODB_URI")
    if not mongo_uri:
        path = pathlib.Path.home() / ".mongodb" / "pvr"
        try:
            mongo_uri = path.read_text(encoding="utf-8").strip()
        except OSError as exc:
            parser.error(f"Cannot read MongoDB URI from {path}: {exc}")
    if not mongo_uri:
        parser.error("MongoDB URI is empty")
    from pymongo import MongoClient
    try:
        with MongoClient(mongo_uri, serverSelectionTimeoutMS=15000) as client:
            client.admin.command("ping")
            scan(client[args.database], roots=args.root, apply=args.apply,
                 probe=not args.no_probe, ffprobe=args.ffprobe,
                 hostname=args.host, verbose=args.verbose)
    except (OSError, ValueError) as exc:
        print(f"PVR inventory: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
